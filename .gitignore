# Label-placement comparison/feedback tool — generated page is large and embeds
# untracked examples/*.ggb renders. Keep the generator (build_feedback_compare.py)
# but ignore the generated HTML, temp render, and exported feedback files.
/docs/label_placement_examples/compare.html
/docs/label_placement_examples/_tmp.svg
/docs/label_placement_examples/label_placement_feedback*

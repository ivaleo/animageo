{
  "format": "animageo-recipe/v1",
  "recipe": "on_line",
  "priority": 2,
  "condition": {
    "kind": "on",
    "pattern": {
      "kind": "on",
      "point": {
        "ref": "X"
      },
      "object": {
        "pair": [
          "A",
          "B"
        ]
      }
    }
  },
  "receiver": "X",

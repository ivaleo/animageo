    "X": "point",
    "A": "point",
    "B": "point"
  },
  "template": [
    {
      "op": "line.by_points",
      "args": {
        "a": "A",
        "b": "B"
      },
      "outputs": {
        "line": "$l"
      }
    },
    {
      "redefine": "X",
      "op": "point.on_path",
      "args": {
        "path": "$l"
      }
    }
  ],
  "check": "statement",
  "phrase": {
    "ru": "{X} на прямой {A}{B}"
  }
}

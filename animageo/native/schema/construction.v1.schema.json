{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animageo.ru/schema/animageo-construction/v1.json",
  "title": "animageo-construction/v1",
  "description": "Construction document read by animageo.native (ref, list, number, expr and template arguments; point, pathParameter, number and angle inputs). Sections the library does not interpret (appearance, styleBinding, timeline, exportDefaults, bindings, workIntent, unknown top-level keys) are kept as is; appearance entries may carry locked (a boolean) and workIntent has a fixed shape, both ignored by evaluation. Rules checked by the library but not written here: viewDefaults.bounds needs xmin < xmax and ymin < ymax.",
  "type": "object",
  "required": [
    "format",
    "documentId",
    "operationRegistryVersion",
    "operations",
    "elements"
  ],
  "properties": {
    "format": {
      "const": "animageo-construction/v1"
    },
    "documentId": {
      "$ref": "#/$defs/id"
    },
    "operationRegistryVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "operations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    },
    "elements": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/element"
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/inputValue"
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": {
        "properties": {
          "locked": {
            "type": "boolean"
          },
          "role": {
            "description": "Style role (1.9.0a1): given, aux or sought; another value is the warning role_unknown and is ignored.",
            "type": "string"
          }
        }
      }
    },
    "styleBinding": {
      "type": "object"
    },
    "timeline": {
      "type": [
        "object",
        "null"
      ]
    },
    "exportDefaults": {
      "type": "object"
    },
    "viewDefaults": {
      "type": "object",
      "properties": {
        "bounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "autoMarks": {
          "type": "object",
          "properties": {
            "rightAngles": {
              "type": "boolean"
            },
            "equalities": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "bindings": {
      "type": "object"
    },
    "workIntent": {
      "$ref": "#/$defs/workIntent"
    },
    "steps": {
      "description": "Explicit steps of the construction (1.9.0a1, native.steps): groups of operations; the other operations are one step each.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "suppressedMarks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suppressedMark"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "slot": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "outputSlot": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[1-9][0-9]*)?$"
    },
    "opName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "point2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "argument": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ref",
            "list",
            "number",
            "expr",
            "template"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/refArgument"
        },
        {
          "$ref": "#/$defs/listArgument"
        },
        {
          "$ref": "#/$defs/numberArgument"
        },
        {
          "$ref": "#/$defs/exprArgument"
        },
        {
          "$ref": "#/$defs/templateArgument"
        }
      ]
    },
    "refArgument": {
      "type": "object",
      "required": [
        "kind",
        "elementId"
      ],
      "properties": {
        "kind": {
          "const": "ref"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "listArgument": {
      "type": "object",
      "required": [
        "kind",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "list"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          }
        }
      },
      "additionalProperties": false
    },
    "numberArgument": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "number"
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "exprArgument": {
      "description": "AST v1 of number.expression (docs/native/expr.md); the schema checks only that ast is an object, validate checks the tree (formula)",
      "type": "object",
      "required": [
        "kind",
        "ast"
      ],
      "properties": {
        "kind": {
          "const": "expr"
        },
        "ast": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "templateArgument": {
      "description": "the template of text.free (docs/native/ops/text.free.md); validate checks its inserts {k} (formula)",
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "template"
        },
        "value": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "op",
        "args",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "$ref": "#/$defs/opName"
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/slot"
          },
          "additionalProperties": {
            "$ref": "#/$defs/argument"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slot",
              "elementId"
            ],
            "properties": {
              "slot": {
                "$ref": "#/$defs/outputSlot"
              },
              "elementId": {
                "$ref": "#/$defs/id"
              }
            },
            "additionalProperties": false
          }
        },
        "branch": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "policy",
                "selector"
              ],
              "properties": {
                "policy": {
                  "type": "string"
                },
                "selector": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "seq": {
          "description": "Order of the operation for the steps and the printer (1.9.0a1): operations without seq first (by ID), then by seq, ties by ID.",
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "type",
        "producer",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "producer": {
          "type": "object",
          "required": [
            "operationId",
            "slot"
          ],
          "properties": {
            "operationId": {
              "$ref": "#/$defs/id"
            },
            "slot": {
              "$ref": "#/$defs/outputSlot"
            }
          },
          "additionalProperties": false
        },
        "displayName": {
          "type": "string"
        },
        "origin": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "inputValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "point"
            },
            "value": {
              "$ref": "#/$defs/point2"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "pathParameter"
            },
            "value": {
              "type": "number"
            },
            "branch": {
              "enum": [
                -1,
                1
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "angle"
            },
            "value": {
              "description": "radians",
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "workIntent": {
      "description": "Intent of the work: the problem text, what the assistant must not do, assumptions. Not used by evaluation.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 4000
            },
            "source": {
              "enum": [
                "typed",
                "photo",
                "voice"
              ]
            },
            "quote": {
              "type": "string"
            },
            "mediaRef": {
              "type": "string"
            }
          }
        },
        "forbid": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "solution",
              "move_given",
              "extra_points"
            ]
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "briefRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "operationIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "given",
            "group",
            "condition"
          ]
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "operationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": [
        "id",
        "mode",
        "statement"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [
            "construct",
            "check"
          ]
        },
        "statement": {
          "type": "object"
        },
        "receiver": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "recipe": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "receiverOrigin": {
          "type": [
            "object",
            "null"
          ]
        },
        "source": {
          "enum": [
            "panel",
            "command",
            "sketch",
            "assistant",
            "shape",
            "tool"
          ]
        },
        "shapeId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "suppressedMark": {
      "type": "object",
      "required": [
        "source",
        "kind"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
